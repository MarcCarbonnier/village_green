{% extends 'base.html.twig' %}

{% block title %}Panier{% endblock %}

{% block body %}
<h1 class="panier_title">Mon Panier</h1>

    <div class="panier_detail">
        {% for item in panier %}
            <div class="card-group" style="width: 18rem;">
                <img src="{{item.produit.photoproduit}}" class="card-img-top" alt="...">
                <div class="card-body">
                    <h5 class="card-title">{{item.produit.libelleProduit}}</h5>
                    <p class="card-text">{{ item.produit.libelleProduit}}</p>
                    <p class="card-text">{{ item.quantite }}</p>
                    <p class="card-text">{{ item.produit.prixVenteHt }} €</p>
                    <p class="card-text">{{ item.produit.prixVenteHt * item.quantite }} €</p>
                </div>
            </div>
        {% endfor %}
    </div>



    <div class="rub_list">
    {% for item in panier %}
        <div class="card-group">
            <div class="card text-bg-light">
                <img src="{{produit.photoproduit}}" class="card-img" alt="...">
                <div class="card-img-overlay">
                    <h2 class="card-title">{{ produit.libelleproduit }}</h2>
                </div>
            </div>
        </div>
    {% endfor %}
</div>






{% endblock %}
