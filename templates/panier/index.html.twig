{% extends 'base.html.twig' %}

{% block title %}Panier{% endblock %}

{% block body %}
<h1 class="panier_title">Mon Panier</h1>

<div class="rub_list">
    {% for item in panier %}
        <div class="card-group">
            <div class="card text-bg-light">
                <img src="../../../img/{{ item.produit.photoProduit }}" class="card-img" alt="...">
                <div class="card-img-overlay">
                    <h2 class="card-title">{{ item.produit.libelleProduit }}</h2>
                    <a href="{{ path('app_panier_del', {'id': item.produit.id}) }}" class="btn btn-danger">
                        Supprimer
                    </a>
                </div>
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}
