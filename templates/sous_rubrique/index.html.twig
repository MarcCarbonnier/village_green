{% extends 'base.html.twig' %}

{% block title %}Rubrique{% endblock %}

{% block body %}

<h1 class="Name">{{ rubrique.nomRubrique }}</h1>

<div class="rub_list">
    {% for sousrubrique in sousrubriques %}
        <div class="card text-bg-light">
            <a class="title" href="{{ path('app_pro', {id: sousrubrique.id}) }}">
                <img src="../img/{{sousrubrique.imgsousrubrique}}" class="card-img" alt="...">
                <div class="card-img-overlay">
                    <h2 class="card-title-white">{{ sousrubrique.nomsousrubrique }}</h2>
                </div>
            </a>
        </div>

    {% endfor %}
</div>

{% endblock %}