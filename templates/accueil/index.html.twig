{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}

<div class="rub_list">
    {% for rubrique in rub %}

    <div class="card text-bg-light">
        <a href="{{ path('app_rub', {id: rubrique.id}) }}">
            <img src="./img/{{rubrique.imgrubrique}}" class="card-img" alt="...">
            <div class="card-img-overlay">
            <h2 class="card-title-white">{{ rubrique.nomrubrique }}</h2>
        </div>
        </a>
    </div>
    
    {% endfor %}
</div>
{% endblock %}