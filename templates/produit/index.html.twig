{% extends 'base.html.twig' %}

{% block title %}Produit{% endblock %}

{% block body %}

<h1 class="Name">{{ sousrubrique.nomSousRubrique }}</h1>

<div class="rub_list">
    {% for produit in produits %}
        <div class="card-group">
            <div class="card text-bg-light">
                <a class="title" href="{{ path('app_produit_fiche', {id: produit.id}) }}">
                    <img src="../../img/{{produit.photoproduit}}" class="card-img" alt="...">
                    <div class="card-img-overlay">
                        <h2 class="card-title">{{ produit.libelleproduit }}</h2>
                    </div>
                </a>
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}